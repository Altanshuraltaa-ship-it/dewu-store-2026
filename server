app.post("/api/checkout", requireAuth, async (req, res) => {
  if (!stripe) return res.status(503).json({ error: "Ð¢Ó©Ð»Ð±Ó©ÑÐ¸Ð¹Ð½ ÑÐ¸ÑÑÐµÐ¼ ÑÐ¾ÑÐ¸ÑÑÑÐ»Ð°Ð°Ð³Ò¯Ð¹ Ð±Ð°Ð¹Ð½Ð°. Stripe ÑÒ¯Ð»ÑÒ¯Ò¯ÑÑÑ ÑÐµÑÐ²ÐµÑÐ¸Ð¹Ð½ environment-Ð´ Ð¾ÑÑÑÐ»Ð½Ð° ÑÑ." });
