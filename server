      }
      qtyById.set(id, (qtyById.get(id) || 0) + quantity);
    }
    const ids = [...qtyById.keys()];
    const found = await pool.query(
      "SELECT id,name,price::float,stock,image_url FROM products WHERE active=TRUE AND id=ANY($1::bigint[])",
