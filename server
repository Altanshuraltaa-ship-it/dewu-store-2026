async function initDb() {
  await pool.query(`
    CREATE TABLE IF NOT EXISTS users (
      id BIGSERIAL PRIMARY KEY,
      name VARCHAR(100) NOT NULL,
      email VARCHAR(254) NOT NULL UNIQUE,
      password_hash TEXT NOT NULL,
      role VARCHAR(20) NOT NULL DEFAULT 'customer' CHECK (role IN ('customer','admin')),
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    );
    CREATE TABLE IF NOT EXISTS products (
      id BIGSERIAL PRIMARY KEY,
      name VARCHAR(120) NOT NULL,
      description TEXT NOT NULL DEFAULT '',
      image_url TEXT NOT NULL DEFAULT '',
      category VARCHAR(50) NOT NULL DEFAULT 'Sneakers',
      price NUMERIC(10,2) NOT NULL CHECK (price >= 0),
      stock INTEGER NOT NULL DEFAULT 0 CHECK (stock >= 0),
      active BOOLEAN NOT NULL DEFAULT TRUE,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    );
    CREATE TABLE IF NOT EXISTS orders (
      id BIGSERIAL PRIMARY KEY,
      user_id BIGINT REFERENCES users(id) ON DELETE SET NULL,
      customer_email VARCHAR(254) NOT NULL,
      items JSONB NOT NULL,
      total NUMERIC(10,2) NOT NULL,
      currency VARCHAR(3) NOT NULL DEFAULT 'usd',
      status VARCHAR(30) NOT NULL DEFAULT 'pending',
      stripe_session_id TEXT UNIQUE,
      stripe_payment_status TEXT,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
      updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    );
    CREATE INDEX IF NOT EXISTS products_active_idx ON products(active);
    CREATE INDEX IF NOT EXISTS orders_created_at_idx ON orders(created_at DESC);
  `);

  const count = await pool.query("SELECT COUNT(*)::int AS n FROM products");
  if (count.rows[0].n === 0) {
    const samples = [
      ["DEWU Runner 01", "Everyday comfort with a clean silhouette.", "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1000&q=85", "Running", 89.00, 18],
      ["DEWU Court Low", "Minimal court sneaker for daily wear.", "https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=1000&q=85", "Lifestyle", 110.00, 12],
      ["DEWU Street High", "A bold high-top built for streetwear.", "https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=1000&q=85", "Streetwear", 125.00, 9],
      ["DEWU Classic White", "A versatile staple for any rotation.", "https://images.unsplash.com/photo-1600185365483-26d7a4cc7519?auto=format&fit=crop&w=1000&q=85", "Lifestyle", 95.00, 24],
      ["DEWU Trail X", "Grip and support for the everyday explorer.", "https://images.unsplash.com/photo-1551107696-a4b0c5a0d9a2?auto=format&fit=crop&w=1000&q=85", "Outdoor", 139.00, 7],
      ["DEWU Retro 90", "Retro-inspired shape with modern comfort.", "https://images.unsplash.com/photo-1460353581641-37baddies?auto=format&fit=crop&w=1000&q=85", "Retro", 105.00, 5]
    ];
    for (const p of samples.slice(0, 5)) {
      await pool.query(
        "INSERT INTO products(name,description,image_url,category,price,stock) VALUES($1,$2,$3,$4,$5,$6)",
        p
      );
    }
  }

  if (process.env.ADMIN_EMAIL && process.env.ADMIN_PASSWORD) {
    const email = process.env.ADMIN_EMAIL.trim().toLowerCase();
    const password = process.env.ADMIN_PASSWORD;
    if (password.length < 12) console.warn("ADMIN_PASSWORD should be at least 12 characters.");
    const hash = await bcrypt.hash(password, 12);
    await pool.query(
      `INSERT INTO users(name,email,password_hash,role) VALUES($1,$2,$3,'admin')
       ON CONFLICT(email) DO UPDATE SET role='admin'`,
      ["DEWU Admin", email, hash]
    );
    console.log(`Admin account ensured for ${email}. Existing password is not changed on conflict.`);
  }
}

